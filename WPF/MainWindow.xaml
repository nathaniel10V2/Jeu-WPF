<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="Window" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Choisissez un jeu" FontSize="35" TextAlignment="Center" />
        <Button Grid.Row="1" Grid.Column="0" Click="btnCarte_Click" HorizontalAlignment="Center" Height="288" Width="146" Margin="50,0,0,0">
            <StackPanel Orientation="Vertical" Height="255" Width="122">
                <Image Source="image/carte.jpg"  Height="226" Width="114"></Image>
                <TextBlock Text="Carte" FontSize="24" TextAlignment="Center" Height="35" Width="92" />
            </StackPanel>
        </Button>
        <Button Grid.Row="1" Grid.Column="1" Click="btnHasard_Click" HorizontalAlignment="Center" Height="288" Width="146">
            <StackPanel Orientation="Vertical" Height="260" Width="124">
                <Image Source="image/dé.jpg"  Height="227" Width="100"></Image>
                <TextBlock Text="Hasard" FontSize="24" TextAlignment="Center" Height="35" Width="92" />
            </StackPanel>
        </Button>
        <Button Grid.Row="1" Grid.Column="2" Click="btnMémoire_Click" HorizontalAlignment="Center" Height="288" Width="146" Margin="0,0,50,0">
            <StackPanel Orientation="Vertical" Height="265" Width="121">
                <Image Source="image/mémoire.jfif"  Height="235" Width="115"></Image>
                <TextBlock Text="Mémoire" FontSize="24" TextAlignment="Center" Height="35" Width="95" />
            </StackPanel>
        </Button>
    </Grid>
</Window>
