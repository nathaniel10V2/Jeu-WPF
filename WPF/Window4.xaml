<Window x:Class="WPF.Window4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="Jeu Mémoire" Height="500" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF2D50FF" Margin="10,10,10,10" />
        <StackPanel Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <TextBlock x:Name="tbkTitreJeu"   TextAlignment="Center"  Text="Jeu de Mémoire"   VerticalAlignment="Center" FontSize="24" FontStyle="Italic" FontWeight="Bold"/>
        </StackPanel>
        <Grid x:Name="GestionJoueursPanel" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid x:Name="SaisieJoueurPanel" Grid.Row="0" Grid.Column="0" Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="tbkInfo"  Grid.ColumnSpan="3" TextWrapping="Wrap" FontSize="14" Foreground="#FF161717" Background="#FFB7ADAD" TextAlignment="Center" Text="Saisissez le nom du joueur " Margin="0,0,0,5"/>
                <TextBox x:Name="tbxSaisie" Grid.Row="1" Grid.ColumnSpan="3" TextWrapping="Wrap" FontSize="24" TextAlignment="Center" RenderTransformOrigin="0.518,0.553" BorderBrush="#FF0E0E0E" BorderThickness="1" >
                </TextBox>
                <Button x:Name="btnAjouter" Grid.Row="2" Grid.Column="2"  Content="Ajouter un joueur" FontSize="14" Click="btnAjouter_Click" Background="#FFDBE3DA" Margin="0,10,0,0"/>
            </Grid>
            <Grid x:Name="listeJoueursPanel" Grid.Row="0" Grid.Column="1" Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="textBlock" Grid.Row="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Text="Liste des joueurs selectionnés"  FontSize="14" TextAlignment="Center" Background="#FFB7ADAD"  Margin="0,0,0,5"/>
                <ListBox x:Name="listeJoueurBox" Grid.Row="1" Grid.ColumnSpan="3" FontSize="24" RenderTransformOrigin="0.508,0.527"  BorderBrush="#FF0E0E0E" BorderThickness="1" >
                    <ListBoxItem/>
                </ListBox>
                <Button x:Name="btnSupprimer" Grid.Row="2" Grid.Column="2" Content="Retirer un joueur"  FontSize="14" Click="btnSupprimer_Click" Margin="0,10,0,0"/>
            </Grid>
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#FF38812B" Margin="10,10,10,10" />
            <StackPanel Grid.ColumnSpan="2" Grid.Row="2" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFCB1717" >
                <Button x:Name="btn_Valider"  Content="Commencer le jeu" HorizontalAlignment="Right"  VerticalAlignment="Bottom"  FontSize="14" Click="btn_Valider_Click"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="JouerPanel" Grid.Row="1" Visibility="Hidden">
            <Grid.Background>
                <ImageBrush/>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>
            <Grid Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Numéro disponibles" Margin="0,0,0,5" FontSize="14" Foreground="#FF161717" Background="#FFB7ADAD"/>
                <ListBox x:Name="lbxNumeroDisponibles" Grid.Row="1"  BorderBrush="#FF0E0E0E" BorderThickness="1" Margin="0,0,0,5">
                    <ListBoxItem/>
                </ListBox>
            </Grid>
            <Grid Grid.Column="1" Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Tour du joueur " Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,5" Foreground="#FF161717" Background="#FFB7ADAD" FontSize="14"/>
                <TextBlock x:Name="tbkJoueurActif"  Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,5" FontSize="14" />
                <TextBlock Text="Premier Numéro :"  Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,5" Foreground="#FF161717" Background="#FFB7ADAD" FontSize="14"/>
                <TextBox x:Name="tbxPremierNumero"  Grid.Row="3" Grid.ColumnSpan="3" BorderBrush="Black" Margin="0,0,0,5" FontSize="14"/>
                <TextBlock Text="Deuxième Numéro :" Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,5" Foreground="#FF161717" Background="#FFB7ADAD" FontSize="14"/>
                <TextBox x:Name="tbxDeuxiemeNumero"  Grid.Row="5" Grid.ColumnSpan="3"  BorderBrush="Black" Margin="0,0,0,5"/>
                <Button x:Name="btnJoueurSuivant" Grid.Row="6" Grid.Column="1" Content="Joueur Suivant" Margin="0,0,0,5" Click="btnJoueurSuivant_Click"/>
                <TextBlock Text="Fruits Révélés" Grid.Row="7" Grid.ColumnSpan="3" Margin="0,10,0,5" Foreground="#FF161717" Background="#FFB7ADAD" FontSize="14"/>
                <TextBlock x:Name="tbkPremierFruitChoisi" Grid.Row="8" Grid.ColumnSpan="3" Margin="0,0,0,5" FontSize="14"/>
                <TextBlock x:Name="tbkDeuxiemeFruitChoisi" Grid.Row="9" Grid.ColumnSpan="3" Margin="0,0,0,5"  FontSize="14"/>
            </Grid>
            <Grid Grid.Column="2" Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Score des Joueurs :" Grid.Row="0" Margin="0,0,0,5" Foreground="#FF161717" Background="#FFB7ADAD" FontSize="14"/>
                <ListBox x:Name="lbxScoreJoueurs" Grid.Row="1" BorderBrush="#FF0E0E0E" BorderThickness="1" Margin="0,0,0,5">
                    <ListBoxItem/>
                </ListBox>
            </Grid>
            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="tbkJoueurGagnant" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0,0,0,10" FontSize="14"/>
                <Button x:Name="btnRetour" Grid.Row="1" Grid.Column="0" Content="Retour" HorizontalAlignment="Left" Margin="0,10,0,5"  FontSize="14" Click="btnRetour_Click" />
                <Button x:Name="btnRejouer" Grid.Row="1" Grid.Column="1" Content="Rejouer" HorizontalAlignment="Right" Margin="0,10,0,5"  FontSize="14" Click="btnRejouer_Click"/>
            </Grid>
        </Grid>
    </Grid>

</Window>
