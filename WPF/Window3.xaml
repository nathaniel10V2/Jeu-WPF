<Window x:Class="WPF.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="Hasard" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF2D50FF" Margin="10,10,10,10" />
        <StackPanel Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <TextBlock x:Name="tbkTitreJeu"   TextAlignment="Center"  Text="Jeu de Hasard"   VerticalAlignment="Center" FontSize="24" FontStyle="Italic" FontWeight="Bold"/>
        </StackPanel>
        <Grid x:Name="GestionJoueursGrille" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid x:Name="SaisieJoueurPanel" Grid.Row="0" Grid.Column="0" Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="tbkInfo"  Grid.ColumnSpan="3" TextWrapping="Wrap" FontSize="14" Foreground="#FF161717" Background="#FFB7ADAD" TextAlignment="Center" Text="Saisissez le nom du joueur " Margin="0,0,0,5"/>
                <TextBox x:Name="tbxSaisie" Grid.Row="1" Grid.ColumnSpan="3" TextWrapping="Wrap" FontSize="24" TextAlignment="Center" RenderTransformOrigin="0.518,0.553" BorderBrush="#FFB7ADAD" BorderThickness="1" >
                </TextBox>
                <Button x:Name="btnAjouter" Grid.Row="2" Grid.Column="2"  Content="Ajouter un joueur" FontSize="14" Padding="10,5,10,5" Click="btnAjouter_Click" Background="#FFDBE3DA" Margin="0,10,0,0"/>
            </Grid>
            <Grid x:Name="listeJoueursPanel" Grid.Row="0" Grid.Column="1" Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="textBlock" Grid.Row="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Text="Liste des joueurs selectionnés"  FontSize="14" TextAlignment="Center" Background="#FFB7ADAD"  Margin="0,0,0,5"/>
                <ListBox x:Name="listeJoueurBox" Grid.Row="1" Grid.ColumnSpan="3" FontSize="24" RenderTransformOrigin="0.508,0.527"  BorderBrush="#FFB7ADAD" BorderThickness="1" >
                    <ListBoxItem/>
                </ListBox>
                <Button x:Name="btnSupprimer" Grid.Row="2" Grid.Column="2" Content="Retirer un joueur" Padding="10,5,10,5" FontSize="14" Click="btnSupprimer_Click" Margin="0,10,0,0"/>
            </Grid>
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#FF38812B" Margin="10,10,10,10" />
            <StackPanel Grid.ColumnSpan="2" Grid.Row="2" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFCB1717" >
                <Button x:Name="btn_Commencer"  Content="Commencer le jeu" Padding="10,5,10,5" HorizontalAlignment="Right"  VerticalAlignment="Bottom"  FontSize="14" Click="btn_Commencer_Click"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="JeuGrille" Grid.Row="1" Margin="10,10,10,10" Visibility="Hidden" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Tour du joueur" FontSize="14" Foreground="#FF161717" Background="#FFB7ADAD" Margin="0,0,0,5"/>
                <Border Grid.Row="1"  Grid.ColumnSpan="2" BorderBrush="#FFB7ADAD" BorderThickness="1" Margin="0,0,0,5">
                    <TextBlock x:Name="tbkJoueurActif" Grid.Row="1"  Grid.ColumnSpan="2" FontSize="14"  HorizontalAlignment="Center" />
                </Border>
                <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#FFB7ADAD" BorderThickness="1" Margin="0,0,0,5">
                    <Image x:Name="imgNuméroDé"  Grid.Row="2" Grid.ColumnSpan="2" Height="70" Width="70"/>
                </Border>
                <Button x:Name="btnLancerDé" Grid.Row="3" Grid.Column="0" Content="Lancer le dé" Padding="10,5,10,5" FontSize="14" Margin="0,0,0,5" Click="btnLancerDé_Click" HorizontalAlignment="Left" />
                <Button x:Name="btnSuivant" Grid.Row="3" Grid.Column="1" Content="Suivant" Padding="10,5,10,5" FontSize="14" Margin="0,0,0,5" Click="btnSuivant_Click" HorizontalAlignment="Right" />
            </Grid>
            <Grid Grid.Column="1" Margin="10,10,10,10" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Plateau de 20 cases" FontSize="14" Foreground="#FF161717" Background="#FFB7ADAD" Margin="0,0,0,5"/>
                <ListBox x:Name="lbxJoueursCases" Grid.Row="1" FontSize="14" BorderBrush="#FFB7ADAD" BorderThickness="1" Margin="0,0,0,5">
                    <ListBoxItem/>
                </ListBox>
            </Grid>
            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="tbkGagnant" Grid.Row="0" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <Button x:Name="btnRetour" Grid.Row="1" Content="Retour" Padding="10,5,10,5"   FontSize="14" Margin="5,0,0,5" Click="btnRetour_Click" HorizontalAlignment="Left" />
                <Button x:Name="btnRejouer" Grid.Row="1" Content="Rejouer" Padding="10,5,10,5"  FontSize="14" Margin="0,0,0,5" Click="btnRejouer_Click" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</Window>
