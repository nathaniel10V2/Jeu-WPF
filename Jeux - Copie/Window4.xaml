<Window x:Class="WPF.Window4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="Mémoire" Height="449" Width="802">
    <Grid x:Name="tbxListe">
        <StackPanel x:Name="MainPanel" Orientation="Vertical">
            <DockPanel>
                <ToolBarTray DockPanel.Dock="Top">
                    <ToolBar>
                        <Button x:Name="btnRetour" Content="Retour" Click="btnRetour_Click" />
                    </ToolBar>
                </ToolBarTray>
            </DockPanel>			
            <StackPanel x:Name="GestionJoueursPanel" Orientation="Vertical" Height="433" Background="#FF2CB41F" >
                <StackPanel x:Name="SelectionJoueursPanel" Orientation="Horizontal">
                    <StackPanel x:Name="listeJoueursPanel" Margin="0,0,1,0" Orientation="Vertical" Width="416" Background="White" Height="325" >
                        <TextBlock x:Name="textBlock" TextWrapping="Wrap" Text="Liste des joueurs selectionnés" Height="62" Width="298" FontSize="24" TextAlignment="Center" Background="#FF2E1497" FontWeight="Bold"/>
                        <TextBlock Height="50"/>
                        <ListBox x:Name="listeJoueurBox" FontSize="24" RenderTransformOrigin="0.508,0.527" Height="104" Width="300" BorderBrush="#FF0E0E0E">
                            <ListBoxItem/>
                        </ListBox>
                        <TextBlock Height="50"/>
                        <Button x:Name="btnSupprimer" Content="Retirer un joueur" Height="56" Width="247" FontSize="24" Click="btnSupprimer_Click" Background="#FFD9D9D9"/>
                    </StackPanel>
                    <StackPanel x:Name="SaisieJoueurPanel" Margin="0,0,1,0" Orientation="Vertical" Width="384" Height="322" Background="White" >
                        <TextBlock x:Name="tbkInfo" TextWrapping="Wrap" Height="37" Width="331" FontSize="24" Foreground="#FF161717" Background="#FFF61A1A" TextAlignment="Center" FontWeight="Bold" Text="Saisissez le nom du joueur ?"/>
                        <TextBlock Height="100"/>
                        <TextBox x:Name="tbxSaisie" TextWrapping="Wrap" Width="247" Height="46" FontSize="24" TextAlignment="Center" RenderTransformOrigin="0.518,0.553" Background="White" >
                            <TextBox.BorderBrush>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="Black"/>
                                    <GradientStop Color="Black" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBox.BorderBrush>
                        </TextBox>
                        <TextBlock Height="82"/>
                        <Button x:Name="btnAjouter" Content="Ajouter un joueur" Width="248" Height="57" FontSize="24" Click="btnAjouter_Click" Background="#FFDBE3DA"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="ValidationPanel" Margin="0,0,1,0" HorizontalAlignment="Right" Height="109" Width="212" >
                    <TextBlock Height="51"/>
                    <Button x:Name="btn_Valider" Content="Commencer le jeu" Height="43" Width="210" FontSize="24" Click="btn_Valider_Click"/>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="JouerPanel" Visibility="Hidden" Height="29" >
                <TextBlock x:Name="tbkInfoJouer" TextWrapping="Wrap" Height="37" Width="331" FontSize="24" Foreground="#FF161717" Background="#FF781414" TextAlignment="Center" FontWeight="Bold" Text="joueur ?"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
